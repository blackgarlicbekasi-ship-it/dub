model BillingAlias {
  id        String   @id @default(cuid())
  userId    String   @unique
  alias     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BillingReport {
  id            String   @id @default(cuid())
  intervalToken String?
  start         DateTime
  end           DateTime
  periode       String
  vercelTotal   Decimal? @db.Decimal(12, 2)
  upstashTotal  Decimal? @db.Decimal(12, 2)
  snapshot      Json     @db.Json
  totalClicks   Int      @default(0)
  snapshotAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index(createdAt)
  @@index([start, end])
}
